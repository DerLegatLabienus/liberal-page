# Local database connection. Copy this file to `.env` and pick ONE target.

# Local Docker Postgres (default — run `npm run db:up` first)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liberal_dev

# Neon (uncomment to point local dev at the cloud DB instead)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require

# Storage pressure — orphan purge. Configured via the `storagePressure` feature flag
# (DB-seeded, on by default), value = "limitMb:slackMb" (e.g. "450:2"); value "-1" disables.
# Only the per-cycle batch size has an optional env override:
# ORPHAN_PURGE_BATCH=5

# Multi-user auth (Google sign-in + JWT). Required in production.
# GOOGLE_CLIENT_ID is the OAuth client ID; the same value goes in the frontend as
# VITE_GOOGLE_CLIENT_ID. JWT_SECRET signs access tokens — use a long random string.
GOOGLE_CLIENT_ID=
JWT_SECRET=
# Token lifetimes in seconds (optional; defaults shown).
# ACCESS_TOKEN_TTL=900
# REFRESH_TOKEN_TTL=2592000
# Frontend (Vite) — the OAuth client ID exposed to the browser:
# VITE_GOOGLE_CLIENT_ID=

# Allowed CORS origin(s) for the API (comma-separated). Defaults to http://localhost:5173.
# In production this MUST include the deployed frontend origin or the browser blocks every
# /api call (including login), e.g. CORS_ORIGIN=https://derlegatlabienus.github.io
# CORS_ORIGIN=http://localhost:5173

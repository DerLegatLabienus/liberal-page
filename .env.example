# Local database connection. Copy this file to `.env` and pick ONE target.

# Local Docker Postgres (default — run `npm run db:up` first)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liberal_dev

# Neon (uncomment to point local dev at the cloud DB instead)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require

# Storage pressure — orphan purge. Configured via the `storagePressure` feature flag
# (DB-seeded, on by default), value = "limitMb:slackMb" (e.g. "450:2"); value "-1" disables.
# Only the per-cycle batch size has an optional env override:
# ORPHAN_PURGE_BATCH=5

# Multi-user auth (Google sign-in + JWT). Required in production.
# GOOGLE_CLIENT_ID is the OAuth client ID; the same value goes in the frontend as
# VITE_GOOGLE_CLIENT_ID. JWT_SECRET signs access tokens — use a long random string.
GOOGLE_CLIENT_ID=
JWT_SECRET=
# Token lifetimes in seconds (optional; defaults shown).
# ACCESS_TOKEN_TTL=900
# REFRESH_TOKEN_TTL=2592000
# Frontend (Vite) — the OAuth client ID exposed to the browser:
# VITE_GOOGLE_CLIENT_ID=

# Microsoft sign-in (optional; unset = the Microsoft button is hidden and POST /auth/microsoft
# returns 503). Azure app registration (SPA platform, public client, no secret needed).
# MICROSOFT_CLIENT_ID is the app's client id; the same value goes to the frontend as
# VITE_MICROSOFT_CLIENT_ID. MICROSOFT_TENANT is currently unused/reserved (default "common"):
# the backend instead validates each id_token's own `iss` claim against Microsoft's issuer
# shape (any tenant), since Microsoft's v2 issuer is always tenant-specific even for multi-
# tenant "common" app registrations — see server/services/auth-providers/microsoft.ts.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT=common
# VITE_MICROSOFT_CLIENT_ID=

# Allowed CORS origin(s) for the API (comma-separated). Defaults to http://localhost:5173.
# In production this MUST include the deployed frontend origin or the browser blocks every
# /api call (including login), e.g. CORS_ORIGIN=https://derlegatlabienus.github.io
# CORS_ORIGIN=http://localhost:5173

# --- Email (Resend) — all server-side only, never expose to the frontend ---
# API key from the Resend dashboard. Unset = email is a no-op (dev/test never send).
# RESEND_API_KEY=re_xxx
# Verified sender; must match a domain verified in Resend.
# EMAIL_FROM=Liberal <noreply@yourdomain>
# Link target used in invitation emails.
# PUBLIC_SITE_URL=https://derlegatlabienus.github.io
# Optional: max sent_emails rows whose delivery status is pulled per poll cycle (default 100).
# Exceeding it logs a warning (over-sampling tripwire) and caps the batch.
# EMAIL_STATUS_POLL_CAP=100
# Optional: rows trimmed per cycle from the sent_emails ledger under storage pressure (default 500).
# SENT_EMAIL_PURGE_BATCH=500

# --- AI (Anthropic Claude) — server-side only ---
# Powers committee summaries and the letter "beautify" button. Unset = those features
# fail closed (beautify returns 503; the button is also gated by the lettersBeautifyEnabled flag).
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-sonnet-4-6).
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Meet Us (Calendly) — server-side only ---
# Personal access token from the Calendly dashboard. Unset = Meet Us reports unconfigured.
# The bookable event type is NOT an env var: it lives in the `meetUs` feature flag value
# (admin panel), so it can be changed live without a restart.
# CALENDLY_API_TOKEN=eyJra...

# Cloudflare R2 — letter image media library (admin upload → public-read images).
# region is always "auto". R2_PUBLIC_BASE_URL must be a PUBLIC object origin
# (https://pub-<hash>.r2.dev or a custom domain) — NOT the Cloudflare dashboard URL.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=prod
R2_PUBLIC_BASE_URL=

# Public share pages (publicSharePages flag) reuse the R2_* vars above (same bucket).
# APP_PUBLIC_URL is the site origin used for the share page's "join & send" CTA link;
# defaults to the GitHub Pages URL when unset. Also used to build the emailed magic-link
# sign-in URL (${APP_PUBLIC_URL}/auth/magic-link?token=...); defaults to localhost:5173.
APP_PUBLIC_URL=
# API_PUBLIC_URL is the backend origin the public share pages' sendBeacon tracking targets;
# defaults to https://liberal-page.onrender.com when unset.
API_PUBLIC_URL=

# Cloudflare Turnstile — public letter send-page bot gate (publicSendTurnstile flag).
# Create a Managed widget in the Cloudflare dashboard (same account as R2), with the
# R2 public hostname (pub-<hash>.r2.dev) in its allowed hostnames.
# TURNSTILE_SITE_KEY is public (baked into the static share page HTML at generation).
# TURNSTILE_SECRET_KEY is server-side only (used for siteverify). Unset = verification
# is skipped (sends still counted). Local test pair: 1x00000000000000000000AA /
# 1x0000000000000000000000000000000AA (always passes).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
